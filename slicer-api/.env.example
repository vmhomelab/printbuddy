# Copy to .env and tweak. Defaults match what Printbuddy expects out of the box.

# Immutable sidecar source revision used by docker-compose.yml's Git build
# context. Bump only after the fork change has been tested and published.
# This revision contains the PrintBuddy profile resolver, stock-profile,
# bundle, and slice-progress contracts.
SLICER_API_BUILD_CONTEXT=https://github.com/vmhomelab/orca-slicer-api.git#048a4c9fee396dbafea97c194f1d48592a34ca44

# Host ports. Printbuddy's virtual-printer feature already binds 3000 and
# 3002, so the OrcaSlicer sidecar sits on 3003. Move them if you run
# this stack on a different host or want to free those ports for VPs.
ORCA_API_PORT=3003
BAMBU_API_PORT=3001

# Slicer versions. Pinned for reproducibility — bump these when you want
# a newer slicer and accept a fresh ~220 MB BambuStudio download.
ORCA_VERSION=2.3.2
BAMBU_VERSION=02.06.00.51
