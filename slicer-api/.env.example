# Copy to .env and tweak. Defaults match what Printbuddy expects out of the box.

# Prebuilt sidecar images on Docker Hub, pulled by `docker compose pull` /
# `docker compose up -d`. `latest` follows Printbuddy's main release (`dev`
# its dev branch), so `docker compose pull && docker compose up -d` keeps the
# sidecar in step with Printbuddy. Printbuddy warns in Settings -> Slicer ->
# "Test slicer connection" when the running sidecar is older than expected.
# To freeze a version instead, use the fixed tag
# <slicer version>-<sidecar revision>, e.g. 2.3.2-f225d76.
# When you build an image yourself, set a local name here (e.g.
# printbuddy-bambu-studio-api:local) so `pull` does not replace your build.
BAMBU_STUDIO_API_IMAGE=docker.io/vmhomelabde/printbuddy-bambu-studio-api:latest
ORCA_SLICER_API_IMAGE=docker.io/vmhomelabde/printbuddy-orca-slicer-api:latest

# Immutable sidecar source revision. Used to build the published images and
# by `docker compose build` for self-built images. Bump only after the fork
# change has been tested and published.
# This revision contains the PrintBuddy profile resolver (vendor-scoped
# inheritance), stock-profile, bundle, and slice-progress contracts, the
# Dockerfile.bambu-studio image, user-printer compatibility via `inherits`,
# the retry without rejected 3MF values, and the revision in GET /health.
SLICER_API_BUILD_CONTEXT=https://github.com/vmhomelab/orca-slicer-api.git#f225d76b536317a6e72ef0a0107c2c01c9cbe618
# Revision reported by a self-built sidecar. Defaults to the commit above; set
# it too when you point SLICER_API_BUILD_CONTEXT at another revision.
#SIDECAR_REVISION=

# Host ports. Printbuddy's virtual-printer feature already binds 3000 and
# 3002, so the OrcaSlicer sidecar sits on 3003. Move them if you run
# this stack on a different host or want to free those ports for VPs.
ORCA_API_PORT=3003
BAMBU_API_PORT=3001

# Slicer versions bundled in the images. Only used when building; the
# prebuilt images above already contain these versions.
ORCA_VERSION=2.3.2
BAMBU_VERSION=02.08.02.61

# Bambu Studio 02.08.x or newer is required: the image is built for its
# Ubuntu 22.04 AppImage (webkit2gtk-4.1). The X2D needs at least 02.05.03.
# The build resolves the AppImage URL through the GitHub releases API. If
# that lookup is rate-limited, set the asset URL from the release page here.
BAMBU_APPIMAGE_URL=
